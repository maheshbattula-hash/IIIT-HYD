# CollectIQ Platform Configuration
PORT=5005
NODE_ENV=development

# AI Provider Configuration: "mock" (default, zero-config), "gemini", or "openai"
AI_PROVIDER=mock

# Optional API Keys if using Gemini or OpenAI
GEMINI_API_KEY=
OPENAI_API_KEY=

# Database configuration (uses embedded node:sqlite in ./server/data/collectiq.db)
DATABASE_FILE=./server/data/collectiq.db
